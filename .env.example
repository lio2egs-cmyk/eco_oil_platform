# =============================================================
# Environment variables required by the Eco-Oil portal backend.
# Copy this file to ".env" locally and fill in real values.
# The real .env is gitignored — never commit secrets.
# =============================================================

# --- Outbound email, channel 1: Resend HTTPS API (PRODUCTION) ---
# Railway blocks outbound SMTP ports, so production sends via Resend's HTTPS
# API. Sign up at resend.com, verify the eco-oil.co.il domain (DNS records),
# create an API key, and set it here / in Railway. The From address/name below
# (MAIL_FROM_ADDRESS / MAIL_FROM_NAME) are reused for Resend too.
RESEND_API_KEY=replace-with-resend-api-key

# --- Outbound email, channel 2: SMTP (LOCAL DEV from the office network) ---
# Used only when RESEND_API_KEY is unset. Google Workspace mailbox at
# portal@eco-oil.co.il with a 16-char App Password (needs 2-Step Verification).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=portal@eco-oil.co.il
MAIL_PASSWORD=replace-with-16-char-app-password
MAIL_FROM_ADDRESS=portal@eco-oil.co.il
MAIL_FROM_NAME=אקו-אויל - פורטל לקוחות

# --- Portal base URL (used to build magic-link URLs in emails) ---
# Local dev: http://localhost:5000
# Production: https://portal.eco-oil.co.il  (eco-depot links auto-routed
# to the depot subdomain by the backend code).
PORTAL_BASE_URL=http://localhost:5000

# --- Flask JWT secret ---
# Use a long random string in production. The default fallback is for local dev only.
JWT_SECRET_KEY=replace-with-strong-random-string
